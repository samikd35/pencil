[
  {
    "start": 1.3,
    "end": 6.02,
    "text": "Arsenal. New season. Same bottle."
  },
  {
    "start": 10.25,
    "end": 12.73,
    "text": "This year, we finish the job."
  },
  {
    "start": 16.34166666666667,
    "end": 17.381666666666668,
    "text": "I ordered a striker."
  },
  {
    "start": 18.791666666666668,
    "end": 20.711666666666666,
    "text": "Sorry. Force of habit."
  },
  {
    "start": 21.89166666666667,
    "end": 23.57166666666667,
    "text": "Get me the striker. Now."
  },
  {
    "start": 25.541666666666668,
    "end": 30.661666666666665,
    "text": "So they bought a striker. Someone to finish the chances."
  },
  {
    "start": 37.041666666666664,
    "end": 38.641666666666666,
    "text": "Then why am I here?"
  },
  {
    "start": 39.141666666666666,
    "end": 40.181666666666665,
    "text": "Win us a corner."
  },
  {
    "start": 42.84166666666666,
    "end": 44.681666666666665,
    "text": "Not the goal! Off him!"
  },
  {
    "start": 49.94166666666666,
    "end": 51.30166666666666,
    "text": "Now we\u2019re dangerous."
  },
  {
    "start": 55.34166666666666,
    "end": 62.38166666666667,
    "text": "Their attacking philosophy? Win a corner. Somebody\u2019s forehead will do the rest."
  },
  {
    "start": 66.45,
    "end": 70.45,
    "text": "ONE\u2013NIL! That\u2019s enough football. Everybody back!"
  },
  {
    "start": 76.83333333333334,
    "end": 83.79333333333334,
    "text": "Lovely. A goalkeeper protecting nine defenders."
  },
  {
    "start": 84.96666666666667,
    "end": 86.96666666666667,
    "text": "What am I supposed to do?"
  },
  {
    "start": 87.46666666666667,
    "end": 88.74666666666667,
    "text": "Win another corner!"
  },
  {
    "start": 92.86666666666667,
    "end": 94.38666666666667,
    "text": "Nobody is getting past us."
  },
  {
    "start": 96.86666666666667,
    "end": 97.50666666666667,
    "text": "Again?"
  },
  {
    "start": 99.36666666666667,
    "end": 104.40666666666668,
    "text": "They could defend a one\u2013nil. They couldn\u2019t defend a lead on the table."
  },
  {
    "start": 108.36666666666667,
    "end": 110.60666666666667,
    "text": "He\u2019s only walking. We\u2019re fine."
  },
  {
    "start": 116.26666666666667,
    "end": 118.10666666666667,
    "text": "WHY IS HE WALKING?"
  },
  {
    "start": 119.86666666666667,
    "end": 121.76633333333335,
    "text": "Long season, Mikel."
  },
  {
    "start": 123.56666666666668,
    "end": 127.40666666666668,
    "text": "Eyes forward! Nobody look back!"
  },
  {
    "start": 128.79166666666666,
    "end": 130.47166666666666,
    "text": "Still delivering in May?"
  },
  {
    "start": 130.97166666666666,
    "end": 132.09166666666667,
    "text": "NOT NOW!"
  },
  {
    "start": 135.89166666666665,
    "end": 137.01166666666666,
    "text": "Keep hold of the lead!"
  },
  {
    "start": 141.09166666666667,
    "end": 143.49166666666667,
    "text": "Penalty. Against Arsenal."
  },
  {
    "start": 144.975,
    "end": 147.775,
    "text": "For a penalty against Arsenal, please hold."
  },
  {
    "start": 152.975,
    "end": 156.095,
    "text": "Mikel! Straight through, as always."
  },
  {
    "start": 157.6583333333333,
    "end": 159.1783333333333,
    "text": "Can you make that go away?"
  },
  {
    "start": 161.45833333333331,
    "end": 164.41833333333332,
    "text": "Of course. Would you like a corner with that?"
  },
  {
    "start": 165.85833333333332,
    "end": 166.73833333333332,
    "text": "Make it two."
  },
  {
    "start": 170.35833333333332,
    "end": 172.663625,
    "text": "Hello? I\u2019m still here."
  },
  {
    "start": 173.16362499999997,
    "end": 175.48362499999996,
    "text": "Your call is very important to us."
  },
  {
    "start": 180.45833333333331,
    "end": 186.9383333333333,
    "text": "One goal for the title. And of course, one bloody corner."
  },
  {
    "start": 188.29166666666666,
    "end": 190.37166666666667,
    "text": "Do I finally get to shoot?"
  },
  {
    "start": 190.87166666666667,
    "end": 192.15166666666667,
    "text": "No. Stand there."
  },
  {
    "start": 194.39166666666665,
    "end": 196.79166666666666,
    "text": "There\u2019s still time."
  },
  {
    "start": 201.26666666666665,
    "end": 204.22666666666666,
    "text": "I\u2019m supposed to be the stri\u2014"
  },
  {
    "start": 209.6833333333333,
    "end": 210.8833333333333,
    "text": "That counts?"
  },
  {
    "start": 211.38333333333333,
    "end": 212.82333333333332,
    "text": "Exactly as rehearsed."
  },
  {
    "start": 215.6833333333333,
    "end": 217.36333333333332,
    "text": "So\u2026 who signs for these?"
  },
  {
    "start": 217.86333333333332,
    "end": 219.14333333333332,
    "text": "Wrong address."
  },
  {
    "start": 221.58333333333331,
    "end": 222.4633333333333,
    "text": "Finally!"
  },
  {
    "start": 222.9633333333333,
    "end": 226.32333333333332,
    "text": "Thank you for waiting. The season has now ended."
  },
  {
    "start": 238.6833333333333,
    "end": 244.0022083333333,
    "text": "I SAID I WAS RETIRED! STOP GIVING ME REASONS TO COME BACK!"
  }
]