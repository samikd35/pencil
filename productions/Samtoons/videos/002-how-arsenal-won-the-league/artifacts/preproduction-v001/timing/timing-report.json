  "lines": [
    {
      "id": "L01",
      "chapter": 1,
      "beat": "N01",
      "role_and_direction": "NARRATOR — dry, certain",
      "text": "Relax. It’s Arsenal. We all know how this ends.",
      "word_count": 9,
      "seconds": 3.8447708333333335,
      "file": "L01.wav",
      "sha256": "18223fc110a8bc6e8da2dd3a0c686f97ecfb80022485eacc07261f399e085797",
      "reference_start_seconds": 0.0
    },
    {
      "id": "L02",
      "chapter": 1,
      "beat": "OP01",
      "role_and_direction": "NARRATOR",
      "text": "Before a ball was kicked, their runners-up medals had arrived.",
      "word_count": 10,
      "seconds": 3.7747916666666668,
      "file": "L02.wav",
      "sha256": "4461454958e3ab7a57c12156d50d2dcdfdaa0567a3af8ff07dfc717d19e21c8d",
      "reference_start_seconds": 4.194770833333333
    },
    {
      "id": "L03",
      "chapter": 1,
      "beat": "OP01",
      "role_and_direction": "COURIER — cheerful",
      "text": "Same order as usual?",
      "word_count": 4,
      "seconds": 1.6945625,
      "file": "L03.wav",
      "sha256": "ea5ef75218cbaf701f489c812b96142e2202f66aa1fc71719575c66ab1e5dc83",
      "reference_start_seconds": 8.3195625
    },
    {
      "id": "L04",
      "chapter": 1,
      "beat": "OP02",
      "role_and_direction": "ARTETA",
      "text": "We haven’t played a game.",
      "word_count": 5,
      "seconds": 1.5685416666666667,
      "file": "L04.wav",
      "sha256": "533d243984835cb2734b2bc70d0de1007c1542f5b5fef6b1782a0f178a07c0ce",
      "reference_start_seconds": 10.364125
    },
    {
      "id": "L05",
      "chapter": 1,
      "beat": "OP02",
      "role_and_direction": "COURIER",
      "text": "Exactly. Beat the rush.",
      "word_count": 4,
      "seconds": 2.0571458333333332,
      "file": "L05.wav",
      "sha256": "920ac151246d7e36da6fd93c48a1256aad2fe89d74dc693d1425e3dbd6747e40",
      "reference_start_seconds": 12.282666666666668
    },
    {
      "id": "L06",
      "chapter": 1,
      "beat": "OP03",
      "role_and_direction": "ARTETA",
      "text": "Get me a striker.",
      "word_count": 4,
      "seconds": 1.290125,
      "file": "L06.wav",
      "sha256": "5333c5b49c823801115cf9cab033acd266d92d1e7a46c90deb632c5d8754c2a9",
      "reference_start_seconds": 14.6898125
    },
    {
      "id": "L07",
      "chapter": 2,
      "beat": "TR01",
      "role_and_direction": "NARRATOR",
      "text": "So they bought a striker. Someone to finish the chances.",
      "word_count": 10,
      "seconds": 3.8997916666666668,
      "file": "L07.wav",
      "sha256": "fbc68ff03d90abd0031cf9419cfc787da3bbe95016e404ee1f93770e13af4682",
      "reference_start_seconds": 16.3299375
    },
    {
      "id": "L08",
      "chapter": 2,
      "beat": "TR02",
      "role_and_direction": "GYÖKERES",
      "text": "Then why am I here?",
      "word_count": 5,
      "seconds": 1.2990625,
      "file": "L08.wav",
      "sha256": "81b87a22b5ab379e69265377965bc1fb8b8d37f3ec7860387649ecfc5e0cd9df",
      "reference_start_seconds": 20.579729166666667
    },
    {
      "id": "L09",
      "chapter": 2,
      "beat": "TR02",
      "role_and_direction": "ARTETA — entirely sincere",
      "text": "Win us a corner.",
      "word_count": 4,
      "seconds": 0.9532916666666666,
      "file": "L09.wav",
      "sha256": "bf60ff4c64923d376f56dbfac6927c528393500e93055a7e68c15edc923785ed",
      "reference_start_seconds": 22.228791666666666
    },
    {
      "id": "L10",
      "chapter": 2,
      "beat": "TR03",
      "role_and_direction": "ARTETA",
      "text": "Not the goal! Off him!",
      "word_count": 5,
      "seconds": 1.7898125,
      "file": "L10.wav",
      "sha256": "7b414806ded4227d734ea9b113b119928c9cb06cdffac90f7258548d47862661",
      "reference_start_seconds": 23.532083333333333
    },
    {
      "id": "L11",
      "chapter": 2,
      "beat": "TR03",
      "role_and_direction": "ARTETA",
      "text": "Now we’re dangerous.",
      "word_count": 3,
      "seconds": 1.4067708333333333,
      "file": "L11.wav",
      "sha256": "f7d4a421c965722f3baff9a3809c7db1e5fbfb995e19e09679c84323f182b437",
      "reference_start_seconds": 25.671895833333334
    },
    {
      "id": "L12",
      "chapter": 3,
      "beat": "CD01",
      "role_and_direction": "NARRATOR",
      "text": "Their attacking philosophy? Win a corner. Somebody’s forehead will do the rest.",
      "word_count": 12,
      "seconds": 5.034708333333334,
      "file": "L12.wav",
      "sha256": "c84aecb3a9bb46a69188a231cea5a5f9cc46e5b2daa3978c19ceea3eea1ce6c8",
      "reference_start_seconds": 27.42866666666667
    },
    {
      "id": "L13",
      "chapter": 3,
      "beat": "CD02",
      "role_and_direction": "ARTETA — cutting through the celebration",
      "text": "ONE–NIL! That’s enough football. Everybody back!",
      "word_count": 7,
      "seconds": 3.7396458333333333,
      "file": "L13.wav",
      "sha256": "25aea4e6db7a94a58afabda7b62f2b5e0806917d2ac112f995638d671ff25d9e",
      "reference_start_seconds": 32.813375
    },
    {
      "id": "L14",
      "chapter": 3,
      "beat": "CD04",
      "role_and_direction": "NARRATOR",
      "text": "Lovely. A goalkeeper protecting nine defenders.",
      "word_count": 6,
      "seconds": 3.4036875,
      "file": "L14.wav",
      "sha256": "a6f3a7f6f8d39b096033de6a056772dffddf5360e479d2379186bf1fdae40d36",
      "reference_start_seconds": 36.903020833333336
    },
    {
      "id": "L15",
      "chapter": 3,
      "beat": "CD05",
      "role_and_direction": "GYÖKERES — calling across the pitch",
      "text": "What am I supposed to do?",
      "word_count": 6,
      "seconds": 1.6845833333333333,
      "file": "L15.wav",
      "sha256": "23305ef1d4807b154b9011be3df1f110f78e055f24f13f478c999a510c70a691",
      "reference_start_seconds": 40.656708333333334
    },
    {
      "id": "L16",
      "chapter": 3,
      "beat": "CD05",
      "role_and_direction": "ARTETA",
      "text": "Win another corner!",
      "word_count": 3,
      "seconds": 1.0807291666666667,
      "file": "L16.wav",
      "sha256": "18af0475f997f6f910a34a1716537aa66740cbcf9ddf813c035dafd195bc0444",
      "reference_start_seconds": 42.691291666666665
    },
    {
      "id": "L17",
      "chapter": 3,
      "beat": "N02",
      "role_and_direction": "ARTETA",
      "text": "Nobody is getting past us.",
      "word_count": 5,
      "seconds": 1.9639583333333333,
      "file": "L17.wav",
      "sha256": "57eaa9233a2adc8523287246cb116c5dc28a172c2e424870d98cad095e33d2ff",
      "reference_start_seconds": 44.12202083333333
    },
    {
      "id": "L18",
      "chapter": 3,
      "beat": "N02",
      "role_and_direction": "ARTETA — suddenly quiet",
      "text": "Again?",
      "word_count": 1,
      "seconds": 0.5478958333333334,
      "file": "L18.wav",
      "sha256": "7554e45dc0c52d4344178aef57fd1b4c92b7611ba07f4e9161ce7a2149fb6b17",
      "reference_start_seconds": 46.43597916666667
    },
    {
      "id": "L19",
      "chapter": 4,
      "beat": "CP01",
      "role_and_direction": "NARRATOR",
      "text": "They could defend a one–nil. They couldn’t defend a lead on the table.",
      "word_count": 14,
      "seconds": 4.0596041666666665,
      "file": "L19.wav",
      "sha256": "9b35d61af253efad18aa59f33f5016e13f9ee7c63ada4b06e634a89a8c7f586c",
      "reference_start_seconds": 47.333875
    },
    {
      "id": "L20",
      "chapter": 4,
      "beat": "CP02",
      "role_and_direction": "ARTETA — briefly reassured",
      "text": "He’s only walking. We’re fine.",
      "word_count": 5,
      "seconds": 2.3074583333333334,
      "file": "L20.wav",
      "sha256": "0fe5f66ceedaaf257f5ffd10e2b66df9134957e09b13fdcfb7c7adb982e0fdc8",
      "reference_start_seconds": 51.74347916666667
    },
    {
      "id": "L21",
      "chapter": 4,
      "beat": "CP03",
      "role_and_direction": "ARTETA — gasping",
      "text": "WHY IS HE WALKING?",
      "word_count": 4,
      "seconds": 1.2318958333333334,
      "file": "L21.wav",
      "sha256": "4d0b431e8283630bad4cf92c09a7328ce2de4e15803261c5b9963004a5b3f3ed",
      "reference_start_seconds": 54.4009375
    },
    {
      "id": "L22",
      "chapter": 4,
      "beat": "CP03",
      "role_and_direction": "PEP — without breaking his stride",
      "text": "Long season, Mikel.",
      "word_count": 3,
      "seconds": 1.777875,
      "file": "L22.wav",
      "sha256": "03ffdb64148e84e0a81716e0e1f478839268f7bdfb8afbf1b0ed58e770207690",
      "reference_start_seconds": 55.98283333333333
    },
    {
      "id": "L23",
      "chapter": 4,
      "beat": "CP04",
      "role_and_direction": "ARTETA",
      "text": "Eyes forward! Nobody look back!",
      "word_count": 5,
      "seconds": 2.3590625,
      "file": "L23.wav",
      "sha256": "fb0fc6a7532d5f7947ac3455458e6ee5004933577be22f1f8be8c17af1aa4cd5",
      "reference_start_seconds": 58.110708333333335
    },
    {
      "id": "L24",
      "chapter": 4,
      "beat": "CP04",
      "role_and_direction": "COURIER",
      "text": "Still delivering in May?",
      "word_count": 4,
      "seconds": 1.5435,
      "file": "L24.wav",
      "sha256": "b113827997559f0caf15b8197904aa92f2b20348c86bb2a9439568f780517dae",
      "reference_start_seconds": 60.81977083333334
    },
    {
      "id": "L25",
      "chapter": 4,
      "beat": "CP04",
      "role_and_direction": "ARTETA",
      "text": "NOT NOW!",
      "word_count": 2,
      "seconds": 0.7797291666666667,
      "file": "L25.wav",
      "sha256": "68c5ba8a948613152bc7cbfb247e1a904fb67a4e13a66cbbcefc8e69fa7bbfb3",
      "reference_start_seconds": 62.71327083333333
    },
    {
      "id": "L26",
      "chapter": 4,
      "beat": "CP05",
      "role_and_direction": "ARTETA",
      "text": "Keep hold of the lead!",
      "word_count": 5,
      "seconds": 1.270625,
      "file": "L26.wav",
      "sha256": "19f16df9f6b4bb920b8199286ef23c2e6d9a3d9bd90aecb387711a84731807c6",
      "reference_start_seconds": 63.843
    },
    {
      "id": "L27",
      "chapter": 5,
      "beat": "VH01",
      "role_and_direction": "REFEREE — confident",
      "text": "Penalty. Against Arsenal.",
      "word_count": 3,
      "seconds": 2.0549791666666666,
      "file": "L27.wav",
      "sha256": "e33cf3260507dc3120ea01be53ecd520e669f51bae586613dfca124e1f30c963",
      "reference_start_seconds": 65.463625
    },
    {
      "id": "L28",
      "chapter": 5,
      "beat": "VH02",
      "role_and_direction": "RECORDED VOICE",
      "text": "For a penalty against Arsenal, please hold.",
      "word_count": 7,
      "seconds": 3.0794166666666665,
      "file": "L28.wav",
      "sha256": "87df033a35a3b6f563bd15c979467269c1c86f9bbc2b02630ec88b15588789a0",
      "reference_start_seconds": 67.86860416666667
    },
    {
      "id": "L29",
      "chapter": 5,
      "beat": "VH03",
      "role_and_direction": "OPERATOR",
      "text": "Mikel! Straight through, as always.",
      "word_count": 5,
      "seconds": 3.182875,
      "file": "L29.wav",
      "sha256": "2d5c1a25adb2384dd0e743d2fcb76c9a278f5c5736740e5b47ca44e916e407d5",
      "reference_start_seconds": 71.29802083333334
    },
    {
      "id": "L30",
      "chapter": 5,
      "beat": "VH04",
      "role_and_direction": "ARTETA — relaxed",
      "text": "Can you make that go away?",
      "word_count": 6,
      "seconds": 1.6308125,
      "file": "L30.wav",
      "sha256": "d3325f5ef70c2a1f3e1fac9c5c3739d8ae1c1118ddf4664e91ee5d8b03ebb12b",
      "reference_start_seconds": 74.83089583333333
    },
    {
      "id": "L31",
      "chapter": 5,
      "beat": "VH04",
      "role_and_direction": "OPERATOR",
      "text": "Of course. Would you like a corner with that?",
      "word_count": 9,
      "seconds": 2.7421875,
      "file": "L31.wav",
      "sha256": "afee594e5d9b6e1fc994d8913a31877260c4a922c55d2257da1ab08dda0e13b7",
      "reference_start_seconds": 76.81170833333333
    },
    {
      "id": "L32",
      "chapter": 5,
      "beat": "VH04",
      "role_and_direction": "ARTETA",
      "text": "Make it two.",
      "word_count": 3,
      "seconds": 0.9305833333333333,
      "file": "L32.wav",
      "sha256": "7d35326e73de3c4309d69b79ac3f68c23ee5f032feec33065a6b3d9dfe4eb48a",
      "reference_start_seconds": 79.90389583333334
    },
    {
      "id": "L33",
      "chapter": 5,
      "beat": "VH05",
      "role_and_direction": "REFEREE",
      "text": "Hello? I’m still here.",
      "word_count": 4,
      "seconds": 1.8501666666666667,
      "file": "L33.wav",
      "sha256": "04f19fcedf66b68443a7ca8a6262c718e589899190275952ab33b8893b5605be",
      "reference_start_seconds": 81.18447916666666
    },
    {
      "id": "L34",
      "chapter": 5,
      "beat": "VH05",
      "role_and_direction": "RECORDED VOICE",
      "text": "Your call is very important to us.",
      "word_count": 7,
      "seconds": 2.2058125,
      "file": "L34.wav",
      "sha256": "a0cf8b196a621ca7d75a5b762fe1eec3615b7d8a3ed8787213b2ffbbab33072e",
      "reference_start_seconds": 83.38464583333334
    },
    {
      "id": "L35",
      "chapter": 6,
      "beat": "FR01",
      "role_and_direction": "NARRATOR — struggling to contain his irritation",
      "text": "One goal for the title. And of course, one bloody corner.",
      "word_count": 11,
      "seconds": 3.9717083333333334,
      "file": "L35.wav",
      "sha256": "8b691015302e7ff55cd328d6831860be30179941b06bdebf660158cfd61a9a41",
      "reference_start_seconds": 85.94045833333334
    },
    {
      "id": "L36",
      "chapter": 6,
      "beat": "FR02",
      "role_and_direction": "GYÖKERES",
      "text": "Do I finally get to shoot?",
      "word_count": 6,
      "seconds": 1.7545208333333333,
      "file": "L36.wav",
      "sha256": "0b2ae5541fb55fcf936ad27b67902f1d5c667c6558dd60540d2d43f8097f74ea",
      "reference_start_seconds": 90.26216666666667
    },
    {
      "id": "L37",
      "chapter": 6,
      "beat": "FR02",
      "role_and_direction": "ARTETA",
      "text": "No. Stand there.",
      "word_count": 3,
      "seconds": 1.6037291666666667,
      "file": "L37.wav",
      "sha256": "b21d5e32913b405a20de9ad583b0f937947953add42b717ddb440e3943422ef1",
      "reference_start_seconds": 92.3666875
    },
    {
      "id": "L38",
      "chapter": 6,
      "beat": "N03",
      "role_and_direction": "NARRATOR — clinging to hope",
      "text": "There’s still time.",
      "word_count": 3,
      "seconds": 1.2642708333333332,
      "file": "L38.wav",
      "sha256": "222cdb5def35e9947b6577857a7a578d2f16350671cafeedac04daad3e935cd6",
      "reference_start_seconds": 94.32041666666667
    },
    {
      "id": "L39",
      "chapter": 6,
      "beat": "FR03",
      "role_and_direction": "GYÖKERES",
      "text": "I’m supposed to be the stri—",
      "word_count": 6,
      "seconds": 1.8017291666666666,
      "file": "L39.wav",
      "sha256": "f63785b871ae8eec7178c6f0f3fae519c9e7fe738cb502c13ac380d1f2885435",
      "reference_start_seconds": 95.9346875
    },
    {
      "id": "L40",
      "chapter": 6,
      "beat": "FR04",
      "role_and_direction": "GYÖKERES",
      "text": "That counts?",
      "word_count": 2,
      "seconds": 1.0436875,
      "file": "L40.wav",
      "sha256": "2b3eb6a173cce7d7ef2302164a5802933ac3086033cdc960b8c59d76fdfd322f",
      "reference_start_seconds": 98.08641666666666
    },
    {
      "id": "L41",
      "chapter": 6,
      "beat": "FR04",
      "role_and_direction": "ARTETA — utterly sincere",
      "text": "Exactly as rehearsed.",
      "word_count": 3,
      "seconds": 1.6391875,
      "file": "L41.wav",
      "sha256": "60ccedb8e44bc7ed7e16774fc5ca7acbebe05f2f46e8b5d9a47f6555994364f8",
      "reference_start_seconds": 99.48010416666666
    },
    {
      "id": "L42",
      "chapter": 6,
      "beat": "FR05",
      "role_and_direction": "COURIER",
      "text": "So… who signs for these?",
      "word_count": 5,
      "seconds": 2.0759791666666665,
      "file": "L42.wav",
      "sha256": "16df8611c007443255b14ef4ce8a9b66dabe70003a243410dce49a91a84ad8ad",
      "reference_start_seconds": 101.46929166666666
    },
    {
      "id": "L43",
      "chapter": 6,
      "beat": "FR05",
      "role_and_direction": "ARTETA",
      "text": "Wrong address.",
      "word_count": 2,
      "seconds": 1.0351041666666667,
      "file": "L43.wav",
      "sha256": "a3109237b67c79cf8651b8d704ea9c538e15912a350957c0050a3f79f8921a09",
      "reference_start_seconds": 103.89527083333333
    },
    {
      "id": "L44",
      "chapter": 6,
      "beat": "VH06",
      "role_and_direction": "REFEREE — suddenly hopeful",
      "text": "Finally!",
      "word_count": 1,
      "seconds": 0.6848125,
      "file": "L44.wav",
      "sha256": "04b751c41282a32246dbaf17f67830b6e756f9e3cfdf30e581e109da52f92e32",
      "reference_start_seconds": 105.280375
    },
    {
      "id": "L45",
      "chapter": 6,
      "beat": "VH06",
      "role_and_direction": "RECORDED VOICE",
      "text": "Thank you for waiting. The season has now ended.",
      "word_count": 9,
      "seconds": 3.1652708333333335,
      "file": "L45.wav",
      "sha256": "14d1b15dad819bfc4aaa533f7b2f517f17c80df80a3c646bf81c9647ac13ccfa",
      "reference_start_seconds": 106.3151875
    },
    {
      "id": "L46",
      "chapter": 7,
      "beat": "N04c",
      "role_and_direction": "FERGUSON — exploding at the television",
      "text": "I SAID I WAS RETIRED!",
      "word_count": 5,
      "seconds": 1.5243125,
      "file": "L46.wav",
      "sha256": "4ceef957361375b7c13a922b15379c57aad20ff5c9136f948a01db1b60ebe9b8",
      "reference_start_seconds": 109.83045833333334
    },
    {
      "id": "L47",
      "chapter": 7,
      "beat": "N04c",
      "role_and_direction": "FERGUSON",
      "text": "STOP GIVING ME REASONS TO COME BACK!",
